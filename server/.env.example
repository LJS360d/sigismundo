# ![REQUIRED] Discord application id (OAuth2 client id)
CLIENT_ID=

# ![REQUIRED] OAuth2 client secret, used to authenticate Activity users
CLIENT_SECRET=

# * [Recommended] A Comma (,) separated list of Discord user IDs that may seize control, and always launch/stop games
OWNER_IDS=

# * [Recommended] Secret for the Activity's session tokens; random per start when unset (users re-auth after restarts)
SESSION_SECRET=

# ? [Not Required] The API address to bind to (defaults to 127.0.0.1:8080, 0.0.0.0:8080 in the image); the activity proxies /api here
SERVER_ADDRESS=

# ? [Not Required] Data directory, holds the Wine prefix (defaults to data, /data in the image)
DATA_DIR=

# ? [Not Required] Games directory and manifest (defaults to /games and <GAMES_DIR>/catalog.yaml)
GAMES_DIR=
CATALOG_PATH=

# ? [Not Required] Wine prefix (defaults to <DATA_DIR>/wine)
WINEPREFIX=

# ? [Not Required] X display number Xvfb takes (defaults to 99, i.e. :99)
DISPLAY_NUM=

# ? [Not Required] spawn = private pulseaudio per session (the image), host = a null sink on the
# running PulseAudio/PipeWire server via pactl (desktops). Defaults to spawn if `pulseaudio` is installed, else host.
AUDIO_MODE=

# ? [Not Required] Wine debug channels (defaults to -all). Wine output is logged at debug level,
# so pair with GO_ENV=development. Black game window: WINEDEBUG=err+all,warn+d3d,+loaddll
WINEDEBUG=

# ? [Not Required] With GO_ENV=development, serve /api/dev-token so the Activity works in a plain browser
DEV_AUTH=

# ! ---------------- Stream ------------------------------------------------------

# ? [Not Required] Capture size (defaults to 1280x720)
STREAM_WIDTH=
STREAM_HEIGHT=

# ? [Not Required] Frames per second (defaults to 30)
STREAM_FPS=

# ? [Not Required] Bitrates in kbps (defaults to 2500 video, 96 audio)
STREAM_VIDEO_KBPS=
STREAM_AUDIO_KBPS=

# ? [Not Required] GPU render node: auto (first accessible /dev/dri/renderD*, the default), none, or a path.
# Pass it to the container (see docker-compose.yml); without one games render and encode on the CPU.
GPU_DEVICE=

# ? [Not Required] Render games on the GPU: auto (the default; yes for Mesa drivers: Intel, AMD, nouveau;
# no for the proprietary NVIDIA driver, which can't present to Xvfb), true or false.
GPU_RENDER=

# ? [Not Required] H.264 encoder: auto (the default; h264_nvenc on NVIDIA, then h264_vaapi, then libx264,
# each checked with a test encode at startup), or one of those to insist on it (falls back to libx264 if it fails).
VIDEO_ENCODER=

# ? [Not Required] End the session after this long without viewers (defaults to 10m)
IDLE_TIMEOUT=

# ? [Not Required] Once the controller leaves the Activity, hand control to the longest-present viewer after this long (defaults to 15s)
CONTROL_GRACE=
