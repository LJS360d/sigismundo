map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

gzip on;
gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

server {
    listen 80;
    root /usr/share/nginx/html;

    # Discord frames the Activity, so no X-Frame-Options; only Discord may embed it.
    add_header Content-Security-Policy "frame-ancestors https://discord.com https://*.discord.com https://*.discordsays.com" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri /index.html;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Security-Policy "frame-ancestors https://discord.com https://*.discord.com https://*.discordsays.com" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location /api/ {
        proxy_pass ${API_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # The stream: no buffering, and sessions outlive nginx's default 60s read timeout.
    location = /api/ws {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
